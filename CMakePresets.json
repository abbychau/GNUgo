{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release (native)",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "debug",
      "displayName": "Debug (native)",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "ubsan",
      "displayName": "UndefinedBehaviorSanitizer (gcc/clang)",
      "description": "Any undefined behavior aborts the engine.",
      "binaryDir": "${sourceDir}/build-ubsan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS": "-fsanitize=undefined -fno-sanitize-recover=all",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=undefined"
      },
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "wasm",
      "displayName": "WebAssembly (Emscripten)",
      "description": "Activate the Emscripten SDK first (emsdk_env), so EMSDK is set.",
      "binaryDir": "${sourceDir}/build-wasm",
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" },
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "wasm-windows",
      "inherits": "wasm",
      "displayName": "WebAssembly (Emscripten, Windows)",
      "description": "Activate the Emscripten SDK first (emsdk_env.bat); needs GNU make on PATH.",
      "generator": "MinGW Makefiles",
      "cacheVariables": { "CMAKE_MAKE_PROGRAM": "make" },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release", "configuration": "Release" },
    { "name": "debug", "configurePreset": "debug", "configuration": "Debug" },
    { "name": "ubsan", "configurePreset": "ubsan" },
    { "name": "wasm", "configurePreset": "wasm" },
    { "name": "wasm-windows", "configurePreset": "wasm-windows" }
  ],
  "testPresets": [
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 8 }
    },
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 8 }
    },
    {
      "name": "ubsan",
      "configurePreset": "ubsan",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 8 },
      "environment": { "UBSAN_OPTIONS": "print_stacktrace=1" }
    },
    {
      "name": "wasm",
      "configurePreset": "wasm",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 8 }
    },
    {
      "name": "wasm-windows",
      "configurePreset": "wasm-windows",
      "output": { "outputOnFailure": true },
      "execution": { "jobs": 8 }
    }
  ]
}
