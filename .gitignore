# ============================================================
# GNU Go .gitignore
# Build artifacts, generated files, and editor noise
# ============================================================

# --- Build output (CMake) ---
/build/
/build-wasm/
/out/
/cmake-build-*/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
CMakeOutput.log
CMakeError.log

# Generated config header
config.h

# --- Compiled objects & executables ---
*.o
*.obj
*.a
*.lib
*.so
*.dll
*.exe
gnugo

# --- Texinfo / doc build products ---
*.aux
*.cp
*.cps
*.dvi
*.fn
*.fns
*.ky
*.kys
*.log
*.pg
*.pgs
*.toc
*.tp
*.tps
*.vr
*.vrs

# --- Editor / OS noise ---
*.swp
*~
.DS_Store
Thumbs.db

# --- Python ---
__pycache__/
*.pyc